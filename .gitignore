# .env - now tracked with safe placeholder values

# Signing material — NEVER commit. This rule used to read
# "uploads-keystore.jks" (note the stray "s"), which matched nothing: the real
# file is upload-keystore.jks, so it sat tracked at the repo root of a PUBLIC
# repository from v1.0.0 onward. Match by extension so a typo can't silently
# expose a key again. android/.gitignore also covers **/*.jks, but only for
# paths under android/ — this catches the rest of the tree.
*.jks
*.keystore
key.properties
android/key.properties

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control. This project
# keeps it local — settings.json here is per-developer machine config.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

