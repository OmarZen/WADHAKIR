<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wird_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/glass_widget_bg"
    android:padding="10dp"
    android:gravity="center"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/wird_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="وردك اليومي"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/almarai"
        android:letterSpacing="0.02"
        android:singleLine="true"
        android:includeFontPadding="false" />

    <ImageView
        android:id="@+id/wird_ring"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginTop="7dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wird_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖"
            android:textSize="13sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/wird_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="على المسار"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:fontFamily="@font/almarai"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textDirection="rtl" />
    </LinearLayout>

    <TextView
        android:id="@+id/wird_motivation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="قليل مستمر خير من كثير منقطع"
        android:textColor="#9FB0CE"
        android:textSize="10sp"
        android:fontFamily="@font/almarai"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center"
        android:textDirection="rtl" />
</LinearLayout>
