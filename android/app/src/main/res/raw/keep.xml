<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps resources that are referenced ONLY from Dart code (via runtime strings
  like `resource://drawable/ic_notification`) and are therefore invisible to
  R8's resource shrinker. Without this, `isShrinkResources = true` strips the
  notification small icon in release builds, so awesome_notifications can't
  post any notification (test, adhan, fasting, wird) — the cause of "works in
  debug, fails in release". `shrinkMode="safe"` keeps normal shrinking for
  everything else.

  @raw/adhan_* are the 13 adhan clips baked into the per-sound notification
  channels. Nothing in Java/Kotlin/XML names them: the only reference is the
  `resource://raw/<name>` string built from AdhanSounds.androidRawRes, which
  awesome_notifications resolves at runtime via Resources.getIdentifier. They
  are listed explicitly rather than left to `shrinkMode="safe"`'s
  getIdentifier heuristic — if that heuristic ever misses, the adhan silently
  degrades to no sound in release only, which is this app's worst failure mode.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification,@mipmap/launcher_icon,@raw/adhan_*"
    tools:shrinkMode="safe" />
