// Pulls in FLUTTER_BUILD_NAME / FLUTTER_BUILD_NUMBER (regenerated by Flutter on
// every build) so the widget extension's version stays in lockstep with the
// host app — App Store validation rejects an extension whose version differs
// from the app's. The extension's MARKETING_VERSION / CURRENT_PROJECT_VERSION
// build settings reference these (set on the target in project.pbxproj).
#include "../Flutter/Generated.xcconfig"
